# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# codebase-memory-mcp local index cache — regenerated per machine, not source
.codebase-memory/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/android/build/
/android/app/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing — never commit these
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Firebase — contains API keys, each developer uses their own
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Firebase Functions dependencies
/functions/node_modules/

# Obfuscation debug symbols
/build/debug-info/

# Tool output
graphify-out/
brag-output/
brag-output-*/

# Local notes and prompt files — never commit
*Update Prompt*
*update prompt*
*Prompt*
*.prompt
notes/
NOTES*

# Promo website — deployed separately (wavelogmobile.app), not part of the
# Flutter app's GitHub repo
/website/
