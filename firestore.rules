rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reaction toggling is validated per-emoji: the only change allowed is
    // adding or removing the caller's own uid from exactly one emoji's list.
    // hasAll() + exact size delta pins the diff to a single element even
    // though list membership isn't positional.
    function reactionToggleValid(emoji) {
      let oldMap = resource.data.get('reactions', {});
      let newMap = request.resource.data.reactions;
      let oldList = oldMap.get(emoji, []);
      let newList = newMap.get(emoji, []);
      return newMap.diff(oldMap).affectedKeys().hasOnly([emoji])
          && (
               (newList.size() == oldList.size() + 1 && newList.hasAll(oldList)
                && request.auth.uid in newList && !(request.auth.uid in oldList))
               ||
               (oldList.size() == newList.size() + 1 && oldList.hasAll(newList)
                && request.auth.uid in oldList && !(request.auth.uid in newList))
             );
    }

    function isValidReactionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.keys().hasOnly(['👍', '❤️', '😂', '😮', '😢', '🙏'])
          && (
               reactionToggleValid('👍') || reactionToggleValid('❤️') || reactionToggleValid('😂')
               || reactionToggleValid('😮') || reactionToggleValid('😢') || reactionToggleValid('🙏')
             );
    }

    // ── Callsign ownership registry ──────────────────────────────────────────
    // Each document id = UPPERCASE callsign, value = { uid, claimedAt }
    // Once created it can never be updated or deleted — immutable binding.
    match /callsign_claims/{callsign} {
      // Single-doc lookups only (needed to check/claim one specific known
      // callsign) — collection-wide listing is blocked so the full
      // callsign→uid mapping can't be scraped by an outside client.
      allow get: if true;
      allow list: if false;
      // Only the authenticated user can create a claim for themselves,
      // and only if that callsign is not yet taken.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid', 'claimedAt'])
                    && callsign.matches('[A-Z0-9/]{3,12}')
                    && !exists(/databases/$(database)/documents/callsign_claims/$(callsign));
      allow update, delete: if false;
    }

    // ── Planned activations ───────────────────────────────────────────────────
    match /planned_activations/{docId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'uid', 'callsign', 'type', 'scheduledAt', 'expiresAt',
                         'bands', 'modes', 'createdAt', 'subscriberCount', 'notified'
                       ])
                    && request.resource.data.callsign is string
                    && request.resource.data.callsign.size() >= 3
                    && request.resource.data.subscriberCount == 0
                    && request.resource.data.notified == false
                    && get(/databases/$(database)/documents/callsign_claims/$(request.resource.data.callsign)).data.uid == request.auth.uid;

      // a) Subscribe/notify updates: subscriberCount can only change by ±1,
      //    notified can only flip true→false (re-arm) never be set to false
      //    from an already-false state (prevents spam re-notification).
      // b) Full edit: authenticated owner only, callsign & uid unchanged
      // Both branches require auth — note the auth check wraps the whole
      // expression so operator precedence can't strand branch (a) unguarded.
      allow update: if request.auth != null
                    && (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount', 'notified'])
                          && (
                               (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount'])
                                && (request.resource.data.subscriberCount == resource.data.subscriberCount + 1
                                    || request.resource.data.subscriberCount == resource.data.subscriberCount - 1)
                                && request.resource.data.subscriberCount >= 0)
                               ||
                               (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notified'])
                                && resource.data.notified == true
                                && request.resource.data.notified == false)
                             ))
                         ||
                         (request.auth.uid == resource.data.uid
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.callsign == resource.data.callsign
                          && request.resource.data.keys().hasAll([
                               'callsign', 'type', 'scheduledAt', 'expiresAt',
                               'bands', 'modes'
                             ]))
                       );

      // Owner only — every doc now carries a uid (legacy uid-less docs
      // were removed as part of this fix).
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // ── Chat rooms ────────────────────────────────────────────────────────────
    match /chat_rooms/{roomId}/messages/{messageId} {
      allow read: if true;

      // Send: authenticated, uid matches auth, callsign verified via claim
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.callsign is string
                    && request.resource.data.callsign.size() >= 3
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && get(/databases/$(database)/documents/callsign_claims/$(request.resource.data.callsign)).data.uid == request.auth.uid;

      // Edit: only the original sender, uid/callsign/timestamp unchanged —
      // OR any authenticated user toggling their own reaction (validated
      // above so no one can spoof another uid's reaction or inject
      // arbitrary keys/text via the reactions map).
      allow update: if request.auth != null
                    && (
                         isValidReactionUpdate()
                         ||
                         (request.auth.uid == resource.data.uid
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.callsign == resource.data.callsign
                          && request.resource.data.timestamp == resource.data.timestamp
                          && request.resource.data.text is string
                          && request.resource.data.text.size() > 0
                          && request.resource.data.text.size() <= 1000)
                       );

      // Delete: only the original sender
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }
  }
}
