<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (dataExtractionRules). Same reasoning as backup_rules.xml:
    the secure-storage prefs file can't be decrypted after a cloud backup
    restore or device-to-device transfer, so it's excluded from both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
