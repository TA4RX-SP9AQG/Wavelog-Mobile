<?xml version="1.0" encoding="utf-8"?>
<!-- USB-serial chips used in radios and CAT cables, by vendor ID (decimal),
     for the USB_DEVICE_ATTACHED filter in AndroidManifest.xml. -->
<resources>
    <usb-device vendor-id="1027" />  <!-- 0x0403 FTDI (Elecraft, many CAT cables) -->
    <usb-device vendor-id="4292" />  <!-- 0x10C4 Silicon Labs CP210x (Icom, Yaesu, Kenwood) -->
    <usb-device vendor-id="6790" />  <!-- 0x1A86 WCH CH34x (Xiegu cables, cheap adapters) -->
    <usb-device vendor-id="1659" />  <!-- 0x067B Prolific PL2303 -->
    <usb-device vendor-id="3110" />  <!-- 0x0C26 Icom (IC-705 and other native USB) -->
</resources>
